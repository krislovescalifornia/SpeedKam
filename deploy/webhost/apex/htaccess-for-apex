# Rename this file to ".htaccess" and place it in the docroot (apex) of a
# domain dedicated to SpeedKam infrastructure (e.g. speedkam.com), where the
# node bundle (receiver + dashboard + data) lives in a subfolder below.
#
# It does three things: forces HTTPS, disables directory listings anywhere on
# the domain, and keeps the whole domain unindexed + hardened. The node bundle
# inherits all of it, so the dashboard is HTTPS-only and never crawled.
#
# Apache 2.4+ on typical shared/cPanel hosting.

# --- Force HTTPS (so the secret, password, and footage are always encrypted) --
# Two conditions, not one: on hosts where TLS is terminated by a front proxy,
# %{HTTPS} can read "off" even for an HTTPS request -- redirecting on that alone
# would loop forever. Also honour X-Forwarded-Proto so a proxied HTTPS request
# is recognised as already-secure and left alone.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Never list directory contents -------------------------------------------
Options -Indexes

# --- Clean 404 for missing paths ---------------------------------------------
# Some shared hosts (seen on Bluehost/cPanel) mishandle non-existent paths:
# missing .php / directories / extensionless URLs get routed to a handler that
# answers 500, and the default ErrorDocument is itself misconfigured (500s too).
# Fix in two parts:
#   1. Short-circuit any request that isn't an existing file or dir to a 404
#      BEFORE the PHP handler runs. Existing paths (receiver, dashboard, media
#      proxy) match -f/-d and are untouched.
#   2. Serve a static page (404.html, shipped next to index.html) for 404/403 --
#      plain HTML, no PHP, so it can't fail the way the host's default does.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

<IfModule mod_headers.c>
    # Keep every response out of search-engine indexes (belt to robots.txt).
    Header set X-Robots-Tag "noindex, nofollow, noarchive"

    # Baseline security headers for the dashboard UI.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer"
    # Pin the browser to HTTPS for a year. Add `includeSubDomains` / `preload`
    # only once every current AND future subdomain is guaranteed to serve HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
